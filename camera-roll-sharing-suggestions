<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Camera Roll Sharing Suggestions - Autrobook</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Light Theme (Default) */
    :root {
      --bg-page: #ffffff;
      --bg-card: #ffffff;
      --bg-box: #f5f6f7;
      --bg-hover: #eaecef;
      --text-main: #000000;
      --text-muted: #4b5563;
      --text-invert: #ffffff;
      --border-color: #d4d4d4;
      --accent-bg: #000000;
      --accent-fg: #ffffff;
      --shadow-card: 0 2px 14px rgba(0, 0, 0, 0.05);
    }

    /* Dark Theme */
    html[data-theme="dark"],
    body.dark,
    body.theme-dark {
      --bg-page: #000000;
      --bg-card: #0c0c0c;
      --bg-box: #161616;
      --bg-hover: #222222;
      --text-main: #ffffff;
      --text-muted: #cbd5e1;
      --text-invert: #000000;
      --border-color: #2e2e2e;
      --accent-bg: #ffffff;
      --accent-fg: #000000;
      --shadow-card: 0 6px 24px rgba(0, 0, 0, 0.65);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      padding-bottom: 56px;
      transition: background-color 0.2s ease, color 0.2s ease;
      overflow-x: hidden;
    }

    /* Sticky Topbar */
    .cr-topbar {
      position: sticky;
      top: 0;
      z-index: 60;
      background-color: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 11px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      flex: 1;
    }

    .back-btn,
    .top-action-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      font-size: 13.5px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      cursor: pointer;
      flex-shrink: 0;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .back-btn:hover,
    .top-action-btn:hover {
      background-color: var(--bg-hover);
      transform: translateY(-1px);
    }

    .topbar-title {
      font-size: clamp(15px, 4vw, 19px);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .cr-pill {
      font-size: 11px;
      font-weight: 800;
      padding: 5px 11px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      white-space: nowrap;
    }

    .cr-pill.active {
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      border-color: var(--accent-bg);
    }

    .cr-off-btn {
      font-size: 11px;
      font-weight: 800;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      white-space: nowrap;
      cursor: pointer;
      transition: background-color 0.15s ease, transform 0.12s ease;
    }

    .cr-off-btn:hover {
      background-color: var(--bg-hover);
      transform: translateY(-1px);
    }

    .cr-off-btn.is-off {
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      border-color: var(--accent-bg);
    }

    /* Main Container */
    .cr-container {
      max-width: 820px;
      margin: 0 auto;
      padding: 16px 14px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Cards */
    .cr-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 18px;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    @media (min-width: 600px) {
      .cr-card {
        padding: 20px;
        gap: 16px;
      }
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .card-title-group {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      flex: 1;
    }

    .card-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
    }

    .cr-heading {
      font-size: clamp(15.5px, 3.8vw, 17px);
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text-main);
    }

    .badge-tag {
      font-size: 11px;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 999px;
      background-color: var(--bg-box);
      color: var(--text-main);
      border: 1px solid var(--border-color);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .cr-text {
      font-size: 13px;
      line-height: 1.65;
      color: var(--text-muted);
    }

    .meta-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .meta-chip {
      font-size: 11px;
      font-weight: 600;
      padding: 5px 11px;
      border-radius: 999px;
      background-color: var(--bg-box);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    /* Form Controls */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    @media (min-width: 600px) {
      .form-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .field-label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
    }

    .cr-select {
      width: 100%;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      font-size: 13px;
      outline: none;
      cursor: pointer;
    }

    .cr-select:focus {
      border-color: var(--text-main);
    }

    /* Toggle Rows */
    .options-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .toggle-row {
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 13px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .option-copy {
      min-width: 0;
      flex: 1;
    }

    .option-copy strong {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
    }

    .option-copy span {
      display: block;
      font-size: 11.5px;
      color: var(--text-muted);
      margin-top: 2px;
      line-height: 1.45;
    }

    .switch-control {
      position: relative;
      display: inline-block;
      width: 48px;
      height: 26px;
      flex-shrink: 0;
      cursor: pointer;
    }

    .switch-control input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .switch-slider {
      position: absolute;
      inset: 0;
      background-color: #737373;
      border-radius: 999px;
      transition: background-color 0.2s ease;
    }

    .switch-slider::before {
      content: "";
      position: absolute;
      width: 20px;
      height: 20px;
      left: 3px;
      top: 3px;
      background-color: #ffffff;
      border-radius: 50%;
      transition: transform 0.2s ease;
    }

    .switch-control input:checked + .switch-slider {
      background-color: var(--accent-bg);
    }

    .switch-control input:checked + .switch-slider::before {
      transform: translateX(22px);
      background-color: var(--accent-fg);
    }

    /* Camera Roll Grid */
    .roll-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    @media (min-width: 560px) {
      .roll-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .roll-item {
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .roll-thumb {
      height: 118px;
      background-color: var(--bg-hover);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .roll-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .roll-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 700;
      padding: 10px;
      text-align: center;
    }

    .roll-meta {
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .roll-title {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .roll-tag {
      font-size: 11px;
      color: var(--text-muted);
    }

    .roll-actions {
      display: flex;
      gap: 6px;
      margin-top: 2px;
    }

    .mini-btn {
      flex: 1;
      padding: 7px 8px;
      border-radius: 9px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-card);
      color: var(--text-main);
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: background-color 0.15s ease;
    }

    .mini-btn:hover {
      background-color: var(--bg-hover);
    }

    .mini-btn.primary {
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      border-color: var(--accent-bg);
    }

    /* Actions */
    .actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      justify-content: flex-end;
    }

    .btn-outline,
    .btn-solid {
      padding: 10px 14px;
      border-radius: 11px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border: 1px solid var(--accent-bg);
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 0.15s ease, transform 0.12s ease;
    }

    .btn-outline {
      background-color: var(--bg-box);
      color: var(--text-main);
    }

    .btn-outline:hover {
      background-color: var(--bg-hover);
      transform: translateY(-1px);
    }

    .btn-solid {
      background-color: var(--accent-bg);
      color: var(--accent-fg);
    }

    .btn-solid:hover {
      transform: translateY(-1px);
    }

    /* Footer */
    .cr-footer {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 14px 16px;
      box-shadow: var(--shadow-card);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .footer-caption {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* Toast */
    #toast {
      position: fixed;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      border: 1px solid var(--border-color);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 999;
      max-width: 90vw;
      text-align: center;
    }

    #toast.show {
      opacity: 1;
    }
  </style>
</head>
<body>
  <header class="cr-topbar">
    <div class="topbar-left">
      <a href="settings.html" class="back-btn" aria-label="Back to Settings">
        <i class="fa-solid fa-arrow-left"></i>
      </a>
      <h1 class="topbar-title">Camera roll sharing suggestions</h1>
    </div>
    <div class="topbar-right">
      <span class="cr-pill active" id="suggestionsPill">ON</span>
      <button type="button" class="cr-off-btn" id="quickOffBtn" aria-label="Turn Camera Roll Sharing Suggestions Off">
        Off
      </button>
      <button type="button" class="top-action-btn" id="syncBtn" aria-label="Sync with Supabase" title="Sync with Supabase">
        <i class="fa-solid fa-rotate"></i>
      </button>
    </div>
  </header>

  <main class="cr-container">
    <!-- Suggestion Controls -->
    <section class="cr-card">
      <div class="card-header">
        <div class="card-title-group">
          <span class="card-icon" aria-hidden="true">
            <i class="fa-solid fa-camera"></i>
          </span>
          <h2 class="cr-heading">Sharing Suggestions Settings</h2>
        </div>
        <span class="badge-tag" id="audienceBadge">Friends</span>
      </div>

      <div class="meta-strip">
        <span class="meta-chip">Platform: Autrobook</span>
        <span class="meta-chip">18+ Free</span>
        <span class="meta-chip" id="syncStatusChip">Local Ready</span>
      </div>

      <p class="cr-text">
        Control whether Autrobook suggests recent photos and moments from your camera roll for stories, posts, or quick sharing.
      </p>

      <div class="form-grid">
        <div class="field-group">
          <label for="defaultAudienceSelect" class="field-label">Default Suggestion Audience</label>
          <select id="defaultAudienceSelect" class="cr-select">
            <option value="friends">Friends</option>
            <option value="public">Public</option>
            <option value="only_me">Only Me (Drafts)</option>
          </select>
        </div>

        <div class="field-group">
          <label for="suggestionFrequencySelect" class="field-label">Suggestion Frequency</label>
          <select id="suggestionFrequencySelect" class="cr-select">
            <option value="daily">Daily Highlights</option>
            <option value="weekly">Weekly Recap</option>
            <option value="manual">Manual Only</option>
          </select>
        </div>
      </div>

      <div class="options-list">
        <div class="toggle-row">
          <div class="option-copy">
            <strong>Camera Roll Sharing Suggestions</strong>
            <span>Show smart photo &amp; highlight suggestions from your gallery</span>
          </div>
          <label class="switch-control" aria-label="Camera Roll Sharing Suggestions">
            <input type="checkbox" id="suggestionsEnabledToggle" checked />
            <span class="switch-slider"></span>
          </label>
        </div>

        <div class="toggle-row">
          <div class="option-copy">
            <strong>Include Screenshots &amp; Edits</strong>
            <span>Allow edited images and screenshots to appear in suggestions</span>
          </div>
          <label class="switch-control" aria-label="Include Screenshots &amp; Edits">
            <input type="checkbox" id="includeScreenshotsToggle" />
            <span class="switch-slider"></span>
          </label>
        </div>

        <div class="toggle-row">
          <div class="option-copy">
            <strong>Sync Preferences to Supabase</strong>
            <span>Save suggestion mode and timestamp to dashboard_state</span>
          </div>
          <label class="switch-control" aria-label="Sync Preferences to Supabase">
            <input type="checkbox" id="cloudSyncToggle" checked />
            <span class="switch-slider"></span>
          </label>
        </div>
      </div>

      <div class="actions-row">
        <input type="file" id="photoPickerInput" accept="image/*" multiple hidden />
        <button type="button" class="btn-outline" id="pickPhotosBtn">
          <i class="fa-regular fa-images"></i>
          <span>Pick Photos</span>
        </button>
        <button type="button" class="btn-solid" id="saveSettingsBtn">
          <i class="fa-regular fa-floppy-disk"></i>
          <span>Save</span>
        </button>
      </div>
    </section>

    <!-- Suggested Items Preview -->
    <section class="cr-card">
      <div class="card-header">
        <div class="card-title-group">
          <span class="card-icon" aria-hidden="true">
            <i class="fa-solid fa-sparkles"></i>
          </span>
          <h2 class="cr-heading">Suggested From Camera Roll</h2>
        </div>
        <span class="badge-tag" id="itemsCountBadge">3 Items</span>
      </div>

      <p class="cr-text">
        Pick photos from your device to test suggestions, share via browser share sheet, or dismiss items you don't want suggested.
      </p>

      <div class="roll-grid" id="suggestionsGrid"></div>
    </section>

    <!-- Footer -->
    <footer class="cr-footer">
      <span class="footer-caption">Autrobook • Settings &amp; privacy</span>
    </footer>
  </main>

  <div id="toast" role="status" aria-live="polite"></div>

  <script>
    (function () {
      const CLOUD_URL = "https://gemyqaniztqrsilayblx.supabase.co";
      const CLOUD_KEY = "sb_publishable_FuH8FWiYVK5CnylcjLDIKQ_exLB_Du_";
      const ROW_ID = "default_dashboard";
      const STORAGE_KEY = "autro_camera_roll_suggestions_v1";

      let memoryStore = {};
      let storageOk = true;
      try {
        window.localStorage.setItem("__cr_test__", "1");
        window.localStorage.removeItem("__cr_test__");
      } catch (e) {
        storageOk = false;
      }

      function readRaw(key) {
        if (storageOk) {
          try {
            return window.localStorage.getItem(key);
          } catch (e) {
            storageOk = false;
          }
        }
        return Object.prototype.hasOwnProperty.call(memoryStore, key) ? memoryStore[key] : null;
      }

      function writeRaw(key, val) {
        memoryStore[key] = val;
        if (storageOk) {
          try {
            window.localStorage.setItem(key, val);
          } catch (e) {
            storageOk = false;
          }
        }
      }

      const defaultItems = [
        { id: "s1", title: "Morning Walk Highlight", tag: "Today • Photo", isScreenshot: false, src: "" },
        { id: "s2", title: "Weekend Sunset Memory", tag: "Yesterday • Camera", isScreenshot: false, src: "" },
        { id: "s3", title: "UI Layout Screenshot", tag: "2d ago • Screenshot", isScreenshot: true, src: "" }
      ];

      function defaultState() {
        return {
          enabled: true,
          includeScreenshots: false,
          cloudSync: true,
          audience: "friends",
          frequency: "daily",
          items: defaultItems,
          updatedAt: ""
        };
      }

      function loadState() {
        try {
          const raw = readRaw(STORAGE_KEY);
          if (!raw) return defaultState();
          const parsed = JSON.parse(raw);
          return Object.assign(defaultState(), parsed, {
            items: Array.isArray(parsed.items) && parsed.items.length ? parsed.items : defaultItems
          });
        } catch (e) {
          return defaultState();
        }
      }

      function saveState(next) {
        try {
          writeRaw(STORAGE_KEY, JSON.stringify(next));
        } catch (e) {}
      }

      let state = loadState();

      function syncTheme() {
        const isDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
        document.body.classList.toggle("dark", isDark);
        document.body.classList.toggle("theme-dark", isDark);
      }

      function showToast(msg) {
        const toast = document.getElementById("toast");
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add("show");
        clearTimeout(window._crToastTimer);
        window._crToastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
      }

      function getVisibleItems() {
        if (!state.enabled) return [];
        return state.items.filter((item) => {
          if (!state.includeScreenshots && item.isScreenshot) return false;
          return true;
        });
      }

      function renderGrid() {
        const grid = document.getElementById("suggestionsGrid");
        const countBadge = document.getElementById("itemsCountBadge");
        if (!grid) return;

        const visible = getVisibleItems();
        if (countBadge) {
          countBadge.textContent = `${visible.length} ${visible.length === 1 ? "Item" : "Items"}`;
        }

        if (!state.enabled) {
          grid.innerHTML =
            '<div class="roll-item"><div class="roll-meta"><strong class="roll-title">Suggestions are Off</strong><span class="roll-tag">Tap "On" or turn on Camera Roll Sharing Suggestions above to see items.</span></div></div>';
          return;
        }

        if (!visible.length) {
          grid.innerHTML =
            '<div class="roll-item"><div class="roll-meta"><strong class="roll-title">No matching suggestions</strong><span class="roll-tag">Tap "Pick Photos" to add images from your device.</span></div></div>';
          return;
        }

        grid.innerHTML = "";
        visible.forEach((item) => {
          const card = document.createElement("div");
          card.className = "roll-item";

          const thumb = document.createElement("div");
          thumb.className = "roll-thumb";
          if (item.src) {
            const img = document.createElement("img");
            img.src = item.src;
            img.alt = item.title;
            thumb.appendChild(img);
          } else {
            const ph = document.createElement("div");
            ph.className = "roll-placeholder";
            ph.innerHTML = `<i class="fa-regular fa-image" style="font-size:20px;"></i><span>${item.isScreenshot ? "Screenshot" : "Photo"}</span>`;
            thumb.appendChild(ph);
          }

          const meta = document.createElement("div");
          meta.className = "roll-meta";

          const titleEl = document.createElement("div");
          titleEl.className = "roll-title";
          titleEl.textContent = item.title;

          const tagEl = document.createElement("div");
          tagEl.className = "roll-tag";
          tagEl.textContent = `${item.tag} • ${state.audience}`;

          const actions = document.createElement("div");
          actions.className = "roll-actions";

          const shareBtn = document.createElement("button");
          shareBtn.type = "button";
          shareBtn.className = "mini-btn primary";
          shareBtn.innerHTML = '<i class="fa-solid fa-share"></i><span>Share</span>';
          shareBtn.addEventListener("click", async () => {
            if (navigator.share) {
              try {
                await navigator.share({
                  title: item.title,
                  text: `Autrobook Suggestion (${state.audience}): ${item.title}`
                });
                showToast("Shared suggestion");
                return;
              } catch (e) {}
            }
            showToast(`Prepared "${item.title}" for ${state.audience}`);
          });

          const hideBtn = document.createElement("button");
          hideBtn.type = "button";
          hideBtn.className = "mini-btn";
          hideBtn.innerHTML = '<i class="fa-solid fa-xmark"></i><span>Hide</span>';
          hideBtn.addEventListener("click", () => {
            state.items = state.items.filter((x) => x.id !== item.id);
            saveState(state);
            renderGrid();
            showToast("Suggestion hidden");
          });

          actions.appendChild(shareBtn);
          actions.appendChild(hideBtn);
          meta.appendChild(titleEl);
          meta.appendChild(tagEl);
          meta.appendChild(actions);
          card.appendChild(thumb);
          card.appendChild(meta);
          grid.appendChild(card);
        });
      }

      function renderControls() {
        const pill = document.getElementById("suggestionsPill");
        const offBtn = document.getElementById("quickOffBtn");
        const audBadge = document.getElementById("audienceBadge");
        const audSel = document.getElementById("defaultAudienceSelect");
        const freqSel = document.getElementById("suggestionFrequencySelect");
        const enToggle = document.getElementById("suggestionsEnabledToggle");
        const scrToggle = document.getElementById("includeScreenshotsToggle");
        const syncToggle = document.getElementById("cloudSyncToggle");

        const isOn = Boolean(state.enabled);

        if (pill) {
          pill.textContent = isOn ? "ON" : "OFF";
          pill.classList.toggle("active", isOn);
        }
        if (offBtn) {
          offBtn.textContent = isOn ? "Off" : "On";
          offBtn.classList.toggle("is-off", !isOn);
        }
        if (audBadge) {
          audBadge.textContent =
            state.audience === "only_me" ? "Only Me" : state.audience === "public" ? "Public" : "Friends";
        }
        if (audSel) audSel.value = state.audience;
        if (freqSel) freqSel.value = state.frequency;
        if (enToggle) enToggle.checked = isOn;
        if (scrToggle) scrToggle.checked = Boolean(state.includeScreenshots);
        if (syncToggle) syncToggle.checked = state.cloudSync !== false;

        renderGrid();
      }

      function collectControls() {
        state.enabled = Boolean(document.getElementById("suggestionsEnabledToggle")?.checked);
        state.includeScreenshots = Boolean(document.getElementById("includeScreenshotsToggle")?.checked);
        state.cloudSync = Boolean(document.getElementById("cloudSyncToggle")?.checked);
        state.audience = document.getElementById("defaultAudienceSelect")?.value || "friends";
        state.frequency = document.getElementById("suggestionFrequencySelect")?.value || "daily";
        state.updatedAt = new Date().toISOString();
      }

      async function syncToSupabase() {
        const chip = document.getElementById("syncStatusChip");
        if (!state.cloudSync) {
          if (chip) chip.textContent = "Sync Off";
          return false;
        }
        try {
          const nowIso = new Date().toISOString();
          const payload = [
            {
              id: ROW_ID,
              quick_note: `CameraRoll: ${state.enabled ? "ON" : "OFF"} | ${state.audience} | ${state.frequency}`,
              updated_at: nowIso
            }
          ];
          const res = await fetch(`${CLOUD_URL}/rest/v1/dashboard_state?on_conflict=id`, {
            method: "POST",
            headers: {
              apikey: CLOUD_KEY,
              Authorization: "Bearer " + CLOUD_KEY,
              "Content-Type": "application/json",
              Prefer: "resolution=merge-duplicates,return=minimal"
            },
            body: JSON.stringify(payload)
          });
          if (res.ok) {
            if (chip) chip.textContent = "Synced";
            return true;
          }
          if (chip) chip.textContent = "Local Only";
          return false;
        } catch (e) {
          if (chip) chip.textContent = "Local Only";
          return false;
        }
      }

      document.getElementById("quickOffBtn")?.addEventListener("click", async () => {
        state.enabled = !state.enabled;
        state.updatedAt = new Date().toISOString();
        saveState(state);
        renderControls();
        showToast(state.enabled ? "Camera roll suggestions On" : "Camera roll suggestions Off");
        if (state.cloudSync) {
          await syncToSupabase();
        }
      });

      [
        "defaultAudienceSelect",
        "suggestionFrequencySelect",
        "suggestionsEnabledToggle",
        "includeScreenshotsToggle",
        "cloudSyncToggle"
      ].forEach((id) => {
        document.getElementById(id)?.addEventListener("change", () => {
          collectControls();
          saveState(state);
          renderControls();
          showToast("Updated camera roll setting");
        });
      });

      document.getElementById("pickPhotosBtn")?.addEventListener("click", () => {
        document.getElementById("photoPickerInput")?.click();
      });

      document.getElementById("photoPickerInput")?.addEventListener("change", (e) => {
        const files = Array.from(e.target.files || []).slice(0, 6);
        if (!files.length) return;

        let loaded = 0;
        files.forEach((file, idx) => {
          const reader = new FileReader();
          reader.onload = () => {
            state.items.unshift({
              id: "picked_" + Date.now() + "_" + idx,
              title: file.name.replace(/\.[^/.]+$/, "") || "Selected Photo",
              tag: "Selected • Photo",
              isScreenshot: /screen/i.test(file.name),
              src: typeof reader.result === "string" ? reader.result : ""
            });
            loaded += 1;
            if (loaded === files.length) {
              state.items = state.items.slice(0, 12);
              saveState(state);
              renderGrid();
              showToast(`Added ${files.length} photo(s)`);
            }
          };
          reader.readAsDataURL(file);
        });
        e.target.value = "";
      });

      document.getElementById("saveSettingsBtn")?.addEventListener("click", async () => {
        collectControls();
        saveState(state);
        renderControls();
        const ok = await syncToSupabase();
        showToast(ok ? "Saved & synced with Supabase" : "Saved locally");
      });

      document.getElementById("syncBtn")?.addEventListener("click", async () => {
        const ok = await syncToSupabase();
        showToast(ok ? "Synced with Supabase" : "Local settings ready");
      });

      if (window.matchMedia) {
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncTheme);
      }

      syncTheme();
      renderControls();
    })();
  </script>
</body>
</html>

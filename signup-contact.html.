<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Autrobook - Sign Up</title>
<style>
body { margin:0; background:#0a1a0f; color:#e4e6eb; font-family:Arial; padding:20px; min-height:100vh; position:relative; }
.back { color:#81c784; text-decoration:none; font-size:24px; }
h1 { font-size:24px; margin:20px 0 5px 0; }
p { color:#b0b3b8; font-size:14px; margin-bottom:20px; }
input { width:100%; padding:14px; margin:8px 0; background:#13261a; border:1px solid #1f3d2a; border-radius:8px; color:#e4e6eb; font-size:15px; outline:none; }
input:focus{ border-color:#4caf50; }
.btn { width:100%; padding:14px; margin:15px 0; border:none; border-radius:8px; font-size:16px; font-weight:bold; cursor:pointer; background:#2e7d32; color:white; }
.btn:active{ background:#1b5e20; }
.btn:disabled{ background:#555; cursor:not-allowed; }
.otp-section { display:none; border-top:1px solid #1f3d2a; padding-top:15px; margin-top:15px; }
.otp-btns { display:flex; gap:10px; }
.otp-btns button { flex:1; padding:12px; background:#2196f3; border:none; color:white; border-radius:8px; cursor:pointer; font-weight:bold; }
.footer-link { text-align:center; color:#4caf50; text-decoration:none; font-size:14px; position:absolute; bottom:30px; left:0; right:0; }
.error { color:#ff5252; font-size:13px; margin-top:5px; text-align:center; }
.success { color:#4caf50; font-size:13px; margin-top:5px; text-align:center; }
.small { font-size:12px; color:#7a9e80; margin-top:5px; }
</style>
</head>
<body>
<a href="signup-name.html" class="back">←</a>
<h1>Enter your contact info</h1>
<p>We'll send you a code to verify your phone number.</p>

<input type="tel" id="phone" placeholder="Phone: +88017XXXXXXXX" autocomplete="tel">
<input type="email" id="email" placeholder="Email Address" autocomplete="email">
<input type="password" id="password" placeholder="Create Password (min 6 chars)" autocomplete="new-password">

<div id="msgBox" class="error"></div>

<div class="otp-section" id="otpSection">
<input type="text" id="otpInput" placeholder="Enter 6-digit OTP" maxlength="6" inputmode="numeric">
<div class="small" id="otpInfo"></div>
<div class="otp-btns">
<button type="button" id="resendBtn" onclick="sendOTP()">Resend SMS</button>
</div>
<button class="btn" id="verifyBtn" onclick="verifyOTP()">Verify & Create Account</button>
</div>

<button class="btn" id="continueBtn" onclick="startSignup()">Continue</button>
<a href="index.html" class="footer-link">Already have an account?</a>

<div id="recaptcha-container"></div>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>

<script>
// Firebase Config
const firebaseConfig = {
apiKey: "AIzaSyBkT_BYBUagMck5z0bLSVRsL_uJs9KUaJI",
authDomain: "autrobook-ad3d5.firebaseapp.com",
projectId: "autrobook-ad3d5",
storageBucket: "autrobook-ad3d5.firebasestorage.app",
messagingSenderId: "554222945815",
appId: "1:554222945815:web:0ba445f3f6ee6de6f1fe52",
measurementId: "G-Z8QM0NVR6W"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

let confirmationResult = null;
let recaptchaVerifier;
let signupTemp = JSON.parse(localStorage.getItem('autrobook_signup_temp') || '{}');

window.onload = () => {
if(!signupTemp.fullName) {
alert("Please enter your name first");
window.location.href = "signup-name.html";
return;
}

recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', {
'size': 'invisible'
});
}

function showMsg(msg, type = 'error') {
const el = document.getElementById('msgBox');
el.className = type;
el.innerText = msg;
}

function validateEmail(email) {
return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

function startSignup(){
let phone = document.getElementById('phone').value.trim();
let email = document.getElementById('email').value.trim();
let password = document.getElementById('password').value;

showMsg('');

if(!phone || !email || !password) {
showMsg('Please fill all fields');
return;
}
if(!phone.startsWith('+880')) {
showMsg('Phone format: +88017XXXXXXXX');
return;
}
if(!validateEmail(email)) {
showMsg('Please enter a valid email');
return;
}
if(password.length < 6) {
showMsg('Password must be at least 6 characters');
return;
}

// Save to temp
signupTemp.phone = phone;
signupTemp.email = email;
signupTemp.password = password;
localStorage.setItem('autrobook_signup_temp', JSON.stringify(signupTemp));

document.getElementById('continueBtn').style.display = 'none';
document.getElementById('otpSection').style.display = 'block';
sendOTP();
}

function sendOTP() {
let phone = signupTemp.phone;
document.getElementById('resendBtn').disabled = true;
document.getElementById('resendBtn').innerText = 'Sending...';

auth.signInWithPhoneNumber(phone, recaptchaVerifier)
.then((result) => {
confirmationResult = result;
showMsg('OTP sent to ' + phone, 'success');
document.getElementById('otpInfo').innerText = 'Code sent to ' + phone;
document.getElementById('resendBtn').disabled = false;
document.getElementById('resendBtn').innerText = 'Resend SMS';
}).catch((error) => {
showMsg(error.message);
document.getElementById('resendBtn').disabled = false;
document.getElementById('resendBtn').innerText = 'Resend SMS';
});
}

function verifyOTP() {
let otp = document.getElementById('otpInput').value;
let btn = document.getElementById('verifyBtn');

if(!confirmationResult) {
showMsg('Please request OTP first');
return;
}
if(otp.length !== 6) {
showMsg('Enter 6 digit OTP');
return;
}

btn.disabled = true;
btn.innerText = 'Verifying...';

confirmationResult.confirm(otp).then((result) => {
const user = result.user;

// Create account with Email + Password
return auth.createUserWithEmailAndPassword(signupTemp.email, signupTemp.password)
.then(() => {
return user.updateProfile({
displayName: signupTemp.fullName
})
}).then(() => {
// Save to Firestore
return db.collection("users").doc(user.uid).set({
uid: user.uid,
name: signupTemp.fullName,
email: signupTemp.email,
phone: signupTemp.phone,
createdAt: firebase.firestore.FieldValue.serverTimestamp()
})
}).then(() => {
// Save session
let sessionUser = {
name: signupTemp.fullName,
email: signupTemp.email,
phone: signupTemp.phone,
id: user.uid,
token: user.uid
};
localStorage.setItem('autrobook_user', JSON.stringify(sessionUser));
localStorage.removeItem('autrobook_signup_temp');

alert('Account Created Successfully! ✅');
window.location.href = 'home.html';
})

}).catch((error) => {
showMsg('Invalid OTP or ' + error.message);
btn.disabled = false;
btn.innerText = 'Verify & Create Account';
});
}

// Redirect if already logged in
if(localStorage.getItem('autrobook_user')) {
window.location.href = 'home.html';
}

// Clickjacking protection
if (window.top !== window.self) { 
window.top.location = window.self.location; 
}
</script>
</body>
</html>

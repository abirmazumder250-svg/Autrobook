{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/splash.html" },
    { "source": "/autrobook", "destination": "/index.html" },
    { "source": "/autrobook/home", "destination": "/index.html" },
    { "source": "/autrobook/splash", "destination": "/splash.html" },
    { "source": "/autrobook/welcome", "destination": "/welcome.html" },
    { "source": "/autrobook/signup", "destination": "/signup-name.html" },
    { "source": "/autrobook/signup-contact", "destination": "/signup-contact.html" },
    { "source": "/autrobook/login", "destination": "/login.html" },
    { "source": "/autrobook/reels", "destination": "/reels.html" },
    { "source": "/autrobook/create-reels", "destination": "/create-reels.html" },
    { "source": "/autrobook/create-post", "destination": "/create-post.html" },
    { "source": "/autrobook/create-story", "destination": "/create-story.html" },
    { "source": "/autrobook/friends", "destination": "/friends.html" },
    { "source": "/autrobook/messages", "destination": "/messages.html" },
    { "source": "/autrobook/notifications", "destination": "/notification.html" },
    { "source": "/autrobook/groups", "destination": "/groups.html" },
    { "source": "/autrobook/pages", "destination": "/pages.html" },
    { "source": "/autrobook/profile", "destination": "/profile.html" },
    { "source": "/autrobook/settings", "destination": "/settings.html" },
    { "source": "/autrobook/ai", "destination": "/autro-ai.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}

{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/public/splash.html" },
    { "source": "/autrobook", "destination": "/public/index.html" },
    { "source": "/autrobook/home", "destination": "/public/index.html" },
    { "source": "/autrobook/splash", "destination": "/public/splash.html" },
    { "source": "/autrobook/welcome", "destination": "/public/welcome.html" },
    { "source": "/autrobook/login", "destination": "/public/login.html" },
    { "source": "/autrobook/reset-password", "destination": "/public/reset-password.html" },
    { "source": "/autrobook/signup", "destination": "/public/signup-name.html" },
    { "source": "/autrobook/signup-name", "destination": "/public/signup-name.html" },
    { "source": "/autrobook/signup-contact", "destination": "/public/signup-contacts.html" },
    { "source": "/autrobook/signup-contacts", "destination": "/public/signup-contacts.html" },
    { "source": "/autrobook/reels", "destination": "/public/reels.html" },
    { "source": "/autrobook/create-reels", "destination": "/public/create-reels.html" },
    { "source": "/autrobook/create-post", "destination": "/public/create-post.html" },
    { "source": "/autrobook/create-story", "destination": "/public/create-story.html" },
    { "source": "/autrobook/friends", "destination": "/public/friends.html" },
    { "source": "/autrobook/messages", "destination": "/public/messages.html" },
    { "source": "/autrobook/notifications", "destination": "/public/notifications.html" },
    { "source": "/autrobook/groups", "destination": "/public/groups.html" },
    { "source": "/autrobook/pages", "destination": "/public/pages.html" },
    { "source": "/autrobook/profile", "destination": "/public/profile.html" },
    { "source": "/autrobook/settings", "destination": "/public/settings.html" },
    { "source": "/autrobook/ai", "destination": "/public/autro-ai.html" },
    { "source": "/autrobook/search", "destination": "/public/search-bar.html" },
    { "source": "/autrobook/storycard", "destination": "/public/storycard.html" },
    { "source": "/autrobook/view-profile", "destination": "/public/view-profile.html" },
    { "source": "/autrobook/comments", "destination": "/public/CommentSection.html" },
    { "source": "/splash.html", "destination": "/public/splash.html" },
    { "source": "/welcome.html", "destination": "/public/welcome.html" },
    { "source": "/login.html", "destination": "/public/login.html" },
    { "source": "/index.html", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}

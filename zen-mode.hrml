<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zen Mode - Autrobook</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg-color: #FFFFFF;
    --surface-color: #FFFFFF;
    --card-color: #F8FAFC;
    --soft-pill: #F1F5F9;
    --text-color: #0F172A;
    --muted-color: #475569;
    --border-color: #E2E8F0;
    --hover-color: rgba(15, 23, 42, 0.05);
    --accent-green: #0B3D20;
    --accent-dark-green: #082C17;
    --accent-soft-bg: rgba(11, 61, 32, 0.10);
    --danger-color: #B91C1C;
    --shadow-soft: 0 4px 18px rgba(15, 23, 42, 0.06);
  }

  [data-theme="dark"],
  html.dark,
  body.dark-theme {
    --bg-color: #202124;
    --surface-color: #202124;
    --card-color: #292A2D;
    --soft-pill: #303134;
    --text-color: #F1F5F9;
    --muted-color: #9AA0A6;
    --border-color: #3C4043;
    --hover-color: rgba(255, 255, 255, 0.07);
    --accent-green: #14532D;
    --accent-dark-green: #0B3D20;
    --accent-soft-bg: rgba(20, 83, 45, 0.28);
    --danger-color: #F87171;
    --shadow-soft: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .zen-shell {
    max-width: 720px;
    margin: 0 auto;
    min-height: 100vh;
    background-color: var(--surface-color);
    display: flex;
    flex-direction: column;
  }

  /* Top Bar */
  .zen-topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background-color: var(--surface-color);
    border-bottom: 1px solid var(--border-color);
  }

  .icon-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--text-color);
    text-decoration: none;
    font-size: 17px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .icon-link-btn:hover {
    background-color: var(--hover-color);
  }

  .zen-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .zen-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-color);
  }

  .zen-live-pill {
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
    background-color: var(--accent-soft-bg);
    color: var(--accent-green);
    border: 1px solid var(--accent-green);
    display: none;
  }

  [data-theme="dark"] .zen-live-pill,
  html.dark .zen-live-pill,
  body.dark-theme .zen-live-pill {
    color: #DCFCE7;
    border-color: #166534;
  }

  .zen-live-pill.active {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  /* Main Content */
  .zen-content {
    padding: 18px 16px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .card {
    background-color: var(--card-color);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 18px;
    box-shadow: var(--shadow-soft);
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent-green);
    background-color: var(--accent-soft-bg);
    border: 1px solid rgba(11, 61, 32, 0.25);
    padding: 5px 11px;
    border-radius: 999px;
  }

  [data-theme="dark"] .hero-badge,
  html.dark .hero-badge,
  body.dark-theme .hero-badge {
    color: #DCFCE7;
    border-color: rgba(22, 101, 52, 0.6);
  }

  .hero-heading {
    margin: 8px 0 6px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.2px;
  }

  .hero-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-color);
  }

  /* Daily Goal Progress */
  .goal-wrap {
    padding: 12px 14px;
    border-radius: 12px;
    background-color: var(--soft-pill);
    border: 1px solid var(--border-color);
  }

  .goal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .goal-track {
    width: 100%;
    height: 8px;
    border-radius: 999px;
    background-color: var(--border-color);
    overflow: hidden;
  }

  .goal-fill {
    height: 100%;
    width: 0%;
    background-color: var(--accent-green);
    border-radius: 999px;
    transition: width 0.25s ease;
  }

  /* Master Toggle Row */
  .master-toggle-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 14px;
    background-color: var(--soft-pill);
    border: 1px solid var(--border-color);
  }

  .toggle-info-title {
    font-size: 15.5px;
    font-weight: 700;
    margin: 0 0 2px;
  }

  .toggle-info-sub {
    font-size: 13px;
    color: var(--muted-color);
    margin: 0;
  }

  .switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 28px;
    flex-shrink: 0;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: #94A3B8;
    border-radius: 999px;
    transition: 0.2s ease;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 22px;
    width: 22px;
    left: 3px;
    bottom: 3px;
    background-color: #FFFFFF;
    border-radius: 50%;
    transition: 0.2s ease;
  }

  input:checked + .slider {
    background-color: var(--accent-green);
  }

  input:checked + .slider:before {
    transform: translateX(22px);
  }

  /* Focus Timer Section */
  .section-title {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 700;
  }

  .section-sub {
    margin: 0 0 14px;
    font-size: 13.5px;
    color: var(--muted-color);
  }

  .preset-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .preset-btn {
    border: 1px solid var(--border-color);
    background-color: var(--soft-pill);
    color: var(--text-color);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset-btn.active {
    background-color: var(--accent-green);
    color: #FFFFFF;
    border-color: var(--accent-green);
  }

  .timer-display-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 22px 16px;
    border-radius: 16px;
    background-color: var(--soft-pill);
    border: 1px solid var(--border-color);
    margin-bottom: 14px;
  }

  .timer-clock {
    font-size: 46px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .timer-intention-input {
    width: 100%;
    max-width: 440px;
    text-align: center;
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    color: var(--text-color);
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13.5px;
    outline: none;
  }

  .timer-intention-input:focus {
    border-color: var(--accent-green);
  }

  .timer-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-primary {
    flex: 1;
    min-width: 130px;
    border: none;
    border-radius: 12px;
    padding: 12px 16px;
    background-color: var(--accent-green);
    color: #FFFFFF;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .btn-primary:hover {
    background-color: var(--accent-dark-green);
  }

  .btn-secondary {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 12px 16px;
    background-color: transparent;
    color: var(--text-color);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  .btn-secondary:hover {
    background-color: var(--hover-color);
  }

  /* Preferences & Sound */
  .option-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .option-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: var(--soft-pill);
  }

  .option-label {
    font-size: 14.5px;
    font-weight: 600;
  }

  .option-desc {
    font-size: 12.5px;
    color: var(--muted-color);
    margin-top: 2px;
  }

  .schedule-inputs {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .time-input {
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    color: var(--text-color);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
  }

  .sound-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 10px;
  }

  @media (max-width: 480px) {
    .sound-grid {
      grid-template-columns: 1fr;
    }
  }

  .sound-chip {
    border: 1px solid var(--border-color);
    background-color: var(--soft-pill);
    color: var(--text-color);
    border-radius: 12px;
    padding: 11px 12px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .sound-chip.active {
    border-color: var(--accent-green);
    background-color: var(--accent-green);
    color: #FFFFFF;
  }

  /* Breathing Guide */
  .breath-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 14px;
    border-radius: 14px;
    background-color: var(--soft-pill);
    border: 1px solid var(--border-color);
    margin-bottom: 12px;
    text-align: center;
  }

  .breath-orb {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background-color: var(--accent-green);
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    margin-bottom: 10px;
    transition: transform 1s ease-in-out;
  }

  .breath-orb.expand {
    transform: scale(1.16);
  }

  .breath-orb.contract {
    transform: scale(0.92);
  }

  /* 5-4-3-2-1 Grounding Checklist */
  .ground-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ground-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background-color: var(--soft-pill);
    border: 1px solid var(--border-color);
    cursor: pointer;
    text-align: left;
    color: var(--text-color);
    font-size: 13.5px;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .ground-step.done {
    background-color: var(--accent-green);
    border-color: var(--accent-green);
    color: #FFFFFF;
  }

  /* Mood & Reflection */
  .mood-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .mood-chip {
    border: 1px solid var(--border-color);
    background-color: var(--soft-pill);
    color: var(--text-color);
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .mood-chip.active {
    background-color: var(--accent-green);
    color: #FFFFFF;
    border-color: var(--accent-green);
  }

  .note-textarea {
    width: 100%;
    min-height: 74px;
    resize: vertical;
    border: 1px solid var(--border-color);
    background-color: var(--soft-pill);
    color: var(--text-color);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 13.5px;
    font-family: inherit;
    outline: none;
  }

  .note-textarea:focus {
    border-color: var(--accent-green);
  }

  /* Stats & History */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 8px;
  }

  .stat-box {
    padding: 14px;
    border-radius: 12px;
    background-color: var(--soft-pill);
    border: 1px solid var(--border-color);
  }

  .stat-value {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 3px;
  }

  .stat-label {
    font-size: 12.5px;
    color: var(--muted-color);
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }

  .history-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: var(--soft-pill);
    font-size: 13px;
  }

  .history-meta {
    color: var(--muted-color);
    font-size: 12px;
  }

  .status-banner {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted-color);
    min-height: 18px;
  }

  /* Footer */
  .zen-footer {
    padding: 18px 16px 28px;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    color: var(--muted-color);
    font-size: 12.5px;
  }

  .zen-footer-brand-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-weight: 700;
    color: var(--text-color);
    font-size: 13px;
  }

  .zen-footer-logo {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: inline-block;
  }
</style>
</head>
<body>

<div class="zen-shell">
  <!-- Top Header -->
  <header class="zen-topbar">
    <a href="settings.html" class="icon-link-btn" aria-label="Back to Settings">
      <i class="fa-solid fa-chevron-left"></i>
    </a>
    <div class="zen-title-wrap">
      <h1 class="zen-title">Zen Mode</h1>
      <span class="zen-live-pill" id="zenLiveBadge">
        <i class="fa-solid fa-spa"></i> Active
      </span>
    </div>
    <button type="button" class="icon-link-btn" id="resetZenBtn" title="Reset Zen preferences" aria-label="Reset Zen preferences">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
  </header>

  <main class="zen-content">
    <!-- Hero & Master Switch -->
    <section class="card hero-card">
      <div>
        <span class="hero-badge"><i class="fa-solid fa-leaf"></i> Calm &amp; Distraction-Free</span>
        <h2 class="hero-heading">Quiet your Autrobook experience</h2>
        <p class="hero-desc">
          Pause noisy alerts, reduce feed clutter, and stay focused with timed calm sessions across your device.
        </p>
      </div>

      <div class="goal-wrap">
        <div class="goal-header">
          <span>Daily Calm Goal (30 min)</span>
          <span id="dailyGoalLabel">0 / 30 min (0%)</span>
        </div>
        <div class="goal-track">
          <div class="goal-fill" id="dailyGoalFill"></div>
        </div>
      </div>

      <div class="master-toggle-box">
        <div>
          <p class="toggle-info-title">Enable Zen Mode</p>
          <p class="toggle-info-sub">Apply calm focus state and save preferences</p>
        </div>
        <label class="switch">
          <input type="checkbox" id="zenMasterToggle">
          <span class="slider"></span>
        </label>
      </div>
    </section>

    <!-- Focus Session Timer -->
    <section class="card">
      <h2 class="section-title">Focus Session Timer</h2>
      <p class="section-sub">Choose a session length and set a clear intention for your time.</p>

      <div class="preset-row" id="durationPresets">
        <button type="button" class="preset-btn active" data-minutes="15">15 min</button>
        <button type="button" class="preset-btn" data-minutes="25">25 min</button>
        <button type="button" class="preset-btn" data-minutes="45">45 min</button>
        <button type="button" class="preset-btn" data-minutes="60">60 min</button>
      </div>

      <div class="timer-display-box">
        <div class="timer-clock" id="timerDisplay">15:00</div>
        <input
          type="text"
          class="timer-intention-input"
          id="zenIntentionInput"
          placeholder="What are you focusing on? (e.g., Deep reading, Creative work)"
          maxlength="120"
        >
      </div>

      <div class="timer-actions">
        <button type="button" class="btn-primary" id="startPauseTimerBtn">
          <i class="fa-solid fa-play"></i>
          <span>Start Session</span>
        </button>
        <button type="button" class="btn-secondary" id="completeSessionBtn">
          <i class="fa-solid fa-check"></i>
          <span>Complete</span>
        </button>
        <button type="button" class="btn-secondary" id="resetTimerBtn">
          <i class="fa-solid fa-stop"></i>
          <span>Reset</span>
        </button>
      </div>

      <div class="status-banner" id="timerStatusText">Ready for a calm session.</div>
    </section>

    <!-- Box Breathing Guide -->
    <section class="card">
      <h2 class="section-title">4-4-4-4 Box Breathing</h2>
      <p class="section-sub">Slow down with a 4-second inhale, hold, exhale, and hold cycle.</p>

      <div class="breath-box">
        <div class="breath-orb" id="breathOrb">
          <span id="breathPhaseLabel">Ready</span>
          <span id="breathCountLabel" style="font-size: 18px;">4s</span>
        </div>
        <div class="option-desc" id="breathHintText">Tap Start Breathing to begin a guided calm cycle.</div>
      </div>

      <div class="timer-actions">
        <button type="button" class="btn-primary" id="toggleBreathBtn">
          <i class="fa-solid fa-wind"></i>
          <span>Start Breathing</span>
        </button>
      </div>
    </section>

    <!-- 5-4-3-2-1 Sensory Grounding -->
    <section class="card">
      <h2 class="section-title">5-4-3-2-1 Grounding Reset</h2>
      <p class="section-sub">Tap each step as you notice your surroundings to bring attention back to now.</p>

      <div class="ground-list" id="groundingSteps">
        <button type="button" class="ground-step" data-step="5">
          <span>5 things you can see around you</span>
          <i class="fa-regular fa-circle"></i>
        </button>
        <button type="button" class="ground-step" data-step="4">
          <span>4 things you can physically feel</span>
          <i class="fa-regular fa-circle"></i>
        </button>
        <button type="button" class="ground-step" data-step="3">
          <span>3 sounds you can hear right now</span>
          <i class="fa-regular fa-circle"></i>
        </button>
        <button type="button" class="ground-step" data-step="2">
          <span>2 scents or fresh breaths you notice</span>
          <i class="fa-regular fa-circle"></i>
        </button>
        <button type="button" class="ground-step" data-step="1">
          <span>1 calm intention for this moment</span>
          <i class="fa-regular fa-circle"></i>
        </button>
      </div>

      <div class="timer-actions">
        <button type="button" class="btn-secondary" id="clearGroundingBtn">
          <i class="fa-solid fa-eraser"></i>
          <span>Clear Steps</span>
        </button>
      </div>
      <div class="status-banner" id="groundingStatusText">0 of 5 grounding steps completed.</div>
    </section>

    <!-- Distraction Controls & Quiet Window -->
    <section class="card">
      <h2 class="section-title">Calm Controls</h2>
      <p class="section-sub">Tailor how Autrobook behaves while you are in Zen Mode.</p>

      <div class="option-list">
        <div class="option-row">
          <div>
            <div class="option-label">Mute non-essential alerts</div>
            <div class="option-desc">Hold promotional and badge pings during calm periods</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="muteAlertsToggle" checked>
            <span class="slider"></span>
          </label>
        </div>

        <div class="option-row">
          <div>
            <div class="option-label">Pause auto-playing media</div>
            <div class="option-desc">Keep videos and reels still until you tap play</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="pauseMediaToggle" checked>
            <span class="slider"></span>
          </label>
        </div>

        <div class="option-row">
          <div>
            <div class="option-label">Gentle session chime</div>
            <div class="option-desc">Play a soft tone when a focus timer finishes</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="gentleChimeToggle" checked>
            <span class="slider"></span>
          </label>
        </div>

        <div class="option-row">
          <div>
            <div class="option-label">Scheduled Quiet Hours</div>
            <div class="option-desc" id="quietWindowStatus">Checking quiet window...</div>
          </div>
          <div class="schedule-inputs">
            <input type="time" class="time-input" id="quietStartInput" value="22:00">
            <span>to</span>
            <input type="time" class="time-input" id="quietEndInput" value="06:00">
          </div>
        </div>
      </div>

      <div style="margin-top: 16px;">
        <div class="option-label">Ambient Soundscape</div>
        <div class="option-desc">Soft synthesized sound played locally in your browser</div>
        <div class="sound-grid" id="soundSelector">
          <button type="button" class="sound-chip active" data-sound="off">
            <i class="fa-solid fa-volume-xmark"></i>
            <span>Silent</span>
          </button>
          <button type="button" class="sound-chip" data-sound="rain">
            <i class="fa-solid fa-cloud-rain"></i>
            <span>Soft Rain</span>
          </button>
          <button type="button" class="sound-chip" data-sound="breeze">
            <i class="fa-solid fa-wind"></i>
            <span>Gentle Breeze</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Mindful Check-in -->
    <section class="card">
      <h2 class="section-title">Mindful Check-in</h2>
      <p class="section-sub">Pick your current state and jot down a quick calm note.</p>

      <div class="mood-row" id="moodSelector">
        <button type="button" class="mood-chip active" data-mood="Calm">Calm</button>
        <button type="button" class="mood-chip" data-mood="Focused">Focused</button>
        <button type="button" class="mood-chip" data-mood="Grateful">Grateful</button>
        <button type="button" class="mood-chip" data-mood="Tired">Tired</button>
      </div>

      <textarea
        class="note-textarea"
        id="mindfulNoteInput"
        placeholder="Write a calm thought, gratitude line, or next step..."
      ></textarea>
      <div class="status-banner" id="noteSavedText">Mindful note saved automatically.</div>
    </section>

    <!-- Focus Summary, Recent Sessions & Supabase Sync -->
    <section class="card">
      <h2 class="section-title">Zen Activity &amp; Sync</h2>
      <p class="section-sub">Local progress saved immediately, with optional cloud backup to Supabase.</p>

      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-value" id="completedSessionsCount">0</div>
          <div class="stat-label">Completed Sessions</div>
        </div>
        <div class="stat-box">
          <div class="stat-value" id="totalFocusMinutes">0 min</div>
          <div class="stat-label">Total Focus Time</div>
        </div>
      </div>

      <div class="history-list" id="sessionHistoryList"></div>

      <div class="timer-actions" style="margin-top: 14px;">
        <button type="button" class="btn-secondary" id="syncSupabaseBtn">
          <i class="fa-solid fa-cloud-arrow-up"></i>
          <span>Sync State to Cloud</span>
        </button>
      </div>
      <div class="status-banner" id="syncStatusText">Synced locally.</div>
    </section>
  </main>

  <footer class="zen-footer">
    <div class="zen-footer-brand-line">
      <img src="logo.png" alt="Autrobook Logo" class="zen-footer-logo" onerror="this.style.display='none'">
      <span>Autrobook</span>
    </div>
    <div>Zen Mode • Designed for calm focus</div>
  </footer>
</div>

<!-- Global Theme & Language Sync -->
<script>
  (function () {
    const THEME_KEYS = ['autro_theme', 'autrobook_theme', 'theme', 'autrobook_dark_mode'];
    const LANG_KEYS = ['autro_lang_code', 'autrobook_lang', 'lang', 'language'];

    function readTheme() {
      for (const k of THEME_KEYS) {
        try {
          const v = (localStorage.getItem(k) || sessionStorage.getItem(k) || '').toLowerCase().trim();
          if (v === 'dark' || v === '1' || v === 'true') return 'dark';
          if (v === 'light' || v === '0' || v === 'false') return 'light';
        } catch (_) {}
      }
      const match = document.cookie.match(/(?:^|;\s*)(?:autro_theme|autrobook_theme)=(dark|light)/i);
      return match ? match[1].toLowerCase() : 'light';
    }

    function applyGlobalTheme(theme) {
      const t = theme === 'dark' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
      document.documentElement.classList.toggle('dark', t === 'dark');
      if (document.body) {
        document.body.setAttribute('data-theme', t);
        document.body.classList.toggle('dark-theme', t === 'dark');
      }
    }

    function readLang() {
      for (const k of LANG_KEYS) {
        try {
          const v = (localStorage.getItem(k) || sessionStorage.getItem(k) || '').trim();
          if (v) return v;
        } catch (_) {}
      }
      const match = document.cookie.match(/(?:^|;\s*)(?:autro_lang_code|autrobook_lang|lang)=([^;]+)/i);
      return match ? decodeURIComponent(match[1]) : 'en';
    }

    async function applyGlobalLang(code) {
      const lang = code || 'en';
      document.documentElement.setAttribute('lang', lang);
      document.documentElement.setAttribute('dir', ['ar', 'he', 'fa', 'ur'].includes(lang) ? 'rtl' : 'ltr');

      const dictMap = {
        en: {
          'Settings & privacy': 'Settings & privacy',
          'Search settings': 'Search settings',
          'Autrobook Account': 'Autrobook Account',
          'Personal details': 'Personal details',
          'Password and security': 'Password and security',
          'Ad preferences': 'Ad preferences',
          'Verification': 'Verification',
          'See more in Autrobook Account': 'See more in Autrobook Account',
          'Subscriptions': 'Subscriptions',
          'Autro Premium': 'Autro Premium',
          'Tools and resources': 'Tools and resources',
          'Privacy checkup': 'Privacy checkup'
        },
        bn: {
          'Settings & privacy': 'সেটিংস ও প্রাইভেসি',
          'Search settings': 'সেটিংস খুঁজুন',
          'Autrobook Account': 'অট্রোবুক অ্যাকাউন্ট',
          'Personal details': 'ব্যক্তিগত তথ্য',
          'Password and security': 'পাসওয়ার্ড ও নিরাপত্তা',
          'Ad preferences': 'বিজ্ঞাপন পছন্দ',
          'Verification': 'ভেরিফিকেশন',
          'See more in Autrobook Account': 'অট্রোবুক অ্যাকাউন্টে আরও দেখুন',
          'Subscriptions': 'সাবস্ক্রিপশন',
          'Autro Premium': 'অট্রো প্রিমিয়াম',
          'Tools and resources': 'টুলস ও রিসোর্স',
          'Privacy checkup': 'প্রাইভেসি চেকআপ'
        }
      };

      const nodes = document.querySelectorAll('h1, h2, h3, h4, p, span, a, button, label, div');
      for (const el of nodes) {
        if (el.children.length > 0) continue;
        if (!el.dataset.origText) {
          el.dataset.origText = (el.textContent || '').trim();
        }
        const baseText = el.dataset.origText;
        if (!baseText) continue;

        if (lang === 'en') {
          el.textContent = baseText;
        } else if (dictMap[lang] && dictMap[lang][baseText]) {
          el.textContent = dictMap[lang][baseText];
        } else {
          try {
            const res = await fetch(
              `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=${encodeURIComponent(lang)}&dt=t&q=${encodeURIComponent(baseText)}`
            );
            if (res.ok) {
              const data = await res.json();
              const translated = Array.isArray(data?.[0]) ? data[0].map((p) => p[0]).join('') : '';
              if (translated && readLang() === lang) {
                el.textContent = translated;
              }
            }
          } catch (_) {}
        }
      }

      const searchInput = document.querySelector('input[type="search"], input[placeholder*="Search"]');
      if (searchInput) {
        if (!searchInput.dataset.origPlaceholder) {
          searchInput.dataset.origPlaceholder = searchInput.placeholder || '';
        }
        const ph = searchInput.dataset.origPlaceholder;
        if (lang === 'en') {
          searchInput.placeholder = ph;
        } else if (dictMap[lang] && dictMap[lang][ph]) {
          searchInput.placeholder = dictMap[lang][ph];
        }
      }
    }

    function syncAll() {
      applyGlobalTheme(readTheme());
      applyGlobalLang(readLang());
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncAll);
    } else {
      syncAll();
    }

    window.addEventListener('pageshow', syncAll);
    window.addEventListener('storage', syncAll);
    window.addEventListener('autro:theme-updated', (e) => applyGlobalTheme(e?.detail?.theme || readTheme()));
    window.addEventListener('autro:lang-updated', (e) => applyGlobalLang(e?.detail?.code || readLang()));

    try {
      if ('BroadcastChannel' in window) {
        new BroadcastChannel('autrobook_theme_sync').onmessage = (e) => {
          if (e?.data?.theme) applyGlobalTheme(e.data.theme);
        };
        new BroadcastChannel('autrobook_lang_sync').onmessage = (e) => {
          if (e?.data?.code) applyGlobalLang(e.data.code);
        };
      }
    } catch (_) {}
  })();
</script>

<!-- Zen Mode Interactive Logic & Supabase Sync -->
<script>
  (function () {
    const SUPABASE_URL = 'https://gemyqaniztqrsilayblx.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_FuH8FWiYVK5CnylcjLDIKQ_exLB_Du_';
    const STORAGE_KEY = 'autrobook_zen_mode_state_v3';
    const DAILY_GOAL_MIN = 30;

    const defaultState = {
      enabled: false,
      presetMinutes: 15,
      remainingSeconds: 15 * 60,
      intention: '',
      muteAlerts: true,
      pauseMedia: true,
      gentleChime: true,
      quietStart: '22:00',
      quietEnd: '06:00',
      sound: 'off',
      mood: 'Calm',
      mindfulNote: '',
      groundedSteps: [],
      completedSessions: 0,
      totalFocusMinutes: 0,
      history: []
    };

    let state = loadState();
    let timerInterval = null;
    let isRunning = false;
    let audioCtx = null;
    let noiseNode = null;

    // Breathing state
    let breathInterval = null;
    let breathRunning = false;
    const breathPhases = [
      { label: 'Inhale', hint: 'Breathe in slowly through your nose', scale: 'expand' },
      { label: 'Hold', hint: 'Hold gently and relax your shoulders', scale: 'expand' },
      { label: 'Exhale', hint: 'Release the breath out smoothly', scale: 'contract' },
      { label: 'Hold', hint: 'Rest softly before the next breath', scale: 'contract' }
    ];
    let breathPhaseIdx = 0;
    let breathSecLeft = 4;

    const zenMasterToggle = document.getElementById('zenMasterToggle');
    const zenLiveBadge = document.getElementById('zenLiveBadge');
    const dailyGoalLabel = document.getElementById('dailyGoalLabel');
    const dailyGoalFill = document.getElementById('dailyGoalFill');

    const presetButtons = Array.from(document.querySelectorAll('.preset-btn'));
    const timerDisplay = document.getElementById('timerDisplay');
    const zenIntentionInput = document.getElementById('zenIntentionInput');
    const startPauseTimerBtn = document.getElementById('startPauseTimerBtn');
    const completeSessionBtn = document.getElementById('completeSessionBtn');
    const resetTimerBtn = document.getElementById('resetTimerBtn');
    const timerStatusText = document.getElementById('timerStatusText');

    const breathOrb = document.getElementById('breathOrb');
    const breathPhaseLabel = document.getElementById('breathPhaseLabel');
    const breathCountLabel = document.getElementById('breathCountLabel');
    const breathHintText = document.getElementById('breathHintText');
    const toggleBreathBtn = document.getElementById('toggleBreathBtn');

    const groundButtons = Array.from(document.querySelectorAll('.ground-step'));
    const clearGroundingBtn = document.getElementById('clearGroundingBtn');
    const groundingStatusText = document.getElementById('groundingStatusText');

    const muteAlertsToggle = document.getElementById('muteAlertsToggle');
    const pauseMediaToggle = document.getElementById('pauseMediaToggle');
    const gentleChimeToggle = document.getElementById('gentleChimeToggle');
    const quietStartInput = document.getElementById('quietStartInput');
    const quietEndInput = document.getElementById('quietEndInput');
    const quietWindowStatus = document.getElementById('quietWindowStatus');
    const soundChips = Array.from(document.querySelectorAll('.sound-chip'));

    const moodChips = Array.from(document.querySelectorAll('.mood-chip'));
    const mindfulNoteInput = document.getElementById('mindfulNoteInput');
    const noteSavedText = document.getElementById('noteSavedText');

    const completedSessionsCount = document.getElementById('completedSessionsCount');
    const totalFocusMinutes = document.getElementById('totalFocusMinutes');
    const sessionHistoryList = document.getElementById('sessionHistoryList');
    const syncSupabaseBtn = document.getElementById('syncSupabaseBtn');
    const syncStatusText = document.getElementById('syncStatusText');
    const resetZenBtn = document.getElementById('resetZenBtn');

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return { ...defaultState };
        const parsed = JSON.parse(raw);
        return {
          ...defaultState,
          ...parsed,
          groundedSteps: Array.isArray(parsed.groundedSteps) ? parsed.groundedSteps : [],
          history: Array.isArray(parsed.history) ? parsed.history : []
        };
      } catch (_) {
        return { ...defaultState };
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        localStorage.setItem('autrobook_zen_mode_enabled', state.enabled ? '1' : '0');
      } catch (_) {}
    }

    function formatTime(totalSec) {
      const safe = Math.max(0, Number(totalSec) || 0);
      const mins = Math.floor(safe / 60);
      const secs = safe % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function isInQuietHours(startStr, endStr) {
      const toMin = (hhmm) => {
        const [h, m] = String(hhmm || '00:00').split(':').map(Number);
        return (Number.isFinite(h) ? h : 0) * 60 + (Number.isFinite(m) ? m : 0);
      };
      const now = new Date();
      const cur = now.getHours() * 60 + now.getMinutes();
      const s = toMin(startStr);
      const e = toMin(endStr);
      if (s === e) return false;
      if (s < e) return cur >= s && cur < e;
      return cur >= s || cur < e;
    }

    function updateQuietWindowStatus() {
      if (!quietWindowStatus) return;
      const active = isInQuietHours(state.quietStart, state.quietEnd);
      quietWindowStatus.textContent = active
        ? `Quiet window is active right now (${state.quietStart} – ${state.quietEnd})`
        : `Scheduled ${state.quietStart} – ${state.quietEnd} (currently outside window)`;
    }

    function ensureAudioContext() {
      if (!audioCtx) {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (Ctx) audioCtx = new Ctx();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    }

    function stopAmbientSound() {
      if (noiseNode) {
        try {
          noiseNode.stop();
          noiseNode.disconnect();
        } catch (_) {}
        noiseNode = null;
      }
    }

    function startAmbientSound(type) {
      stopAmbientSound();
      if (!type || type === 'off') return;
      const ctx = ensureAudioContext();
      if (!ctx) return;

      try {
        const bufferSize = ctx.sampleRate * 2;
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        let lastOut = 0.0;
        for (let i = 0; i < bufferSize; i++) {
          const white = Math.random() * 2 - 1;
          data[i] = (lastOut + 0.03 * white) / 1.03;
          lastOut = data[i];
          data[i] *= type === 'rain' ? 0.14 : 0.09;
        }

        const src = ctx.createBufferSource();
        src.buffer = buffer;
        src.loop = true;

        const filter = ctx.createBiquadFilter();
        filter.type = type === 'rain' ? 'bandpass' : 'lowpass';
        filter.frequency.value = type === 'rain' ? 900 : 380;

        src.connect(filter);
        filter.connect(ctx.destination);
        src.start();
        noiseNode = src;
      } catch (_) {}
    }

    function playGentleChime() {
      if (!state.gentleChime) return;
      const ctx = ensureAudioContext();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(528, ctx.currentTime);
        gain.gain.setValueAtTime(0.001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.08, ctx.currentTime + 0.08);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.4);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 1.45);
      } catch (_) {}
    }

    function recordCompletedSession(minutesDone) {
      const mins = Math.max(1, Number(minutesDone) || state.presetMinutes || 15);
      state.completedSessions += 1;
      state.totalFocusMinutes += mins;
      const entry = {
        title: (state.intention || '').trim() || 'Mindful Focus Session',
        minutes: mins,
        mood: state.mood || 'Calm',
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      };
      state.history = [entry, ...(state.history || [])].slice(0, 5);
      saveState();
      renderUI();
      playGentleChime();
      timerStatusText.textContent = `Completed a ${mins}-minute Zen session.`;
    }

    function pauseTimer() {
      isRunning = false;
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
      stopAmbientSound();
      renderTimerControls();
    }

    function startTimer() {
      if (isRunning) return;
      if (!state.enabled) {
        state.enabled = true;
        saveState();
      }
      if (state.remainingSeconds <= 0) {
        state.remainingSeconds = state.presetMinutes * 60;
      }
      isRunning = true;
      if (state.sound !== 'off') {
        startAmbientSound(state.sound);
      }
      renderUI();
      renderTimerControls();
      timerStatusText.textContent = state.intention
        ? `Focusing on: ${state.intention}`
        : 'Zen session in progress...';

      timerInterval = setInterval(() => {
        state.remainingSeconds -= 1;
        if (state.remainingSeconds <= 0) {
          const finishedMins = state.presetMinutes;
          state.remainingSeconds = finishedMins * 60;
          pauseTimer();
          recordCompletedSession(finishedMins);
        } else {
          timerDisplay.textContent = formatTime(state.remainingSeconds);
          saveState();
        }
      }, 1000);
    }

    function renderTimerControls() {
      if (!startPauseTimerBtn) return;
      if (isRunning) {
        startPauseTimerBtn.innerHTML = '<i class="fa-solid fa-pause"></i><span>Pause</span>';
      } else {
        startPauseTimerBtn.innerHTML = '<i class="fa-solid fa-play"></i><span>Start Session</span>';
      }
    }

    function updateBreathVisual() {
      const p = breathPhases[breathPhaseIdx];
      breathPhaseLabel.textContent = p.label;
      breathCountLabel.textContent = `${breathSecLeft}s`;
      breathHintText.textContent = p.hint;
      breathOrb.classList.remove('expand', 'contract');
      breathOrb.classList.add(p.scale);
    }

    function stopBreathing() {
      breathRunning = false;
      if (breathInterval) {
        clearInterval(breathInterval);
        breathInterval = null;
      }
      breathPhaseIdx = 0;
      breathSecLeft = 4;
      breathOrb.classList.remove('expand', 'contract');
      breathPhaseLabel.textContent = 'Ready';
      breathCountLabel.textContent = '4s';
      breathHintText.textContent = 'Tap Start Breathing to begin a guided calm cycle.';
      toggleBreathBtn.innerHTML = '<i class="fa-solid fa-wind"></i><span>Start Breathing</span>';
    }

    function startBreathing() {
      if (breathRunning) return;
      breathRunning = true;
      breathPhaseIdx = 0;
      breathSecLeft = 4;
      updateBreathVisual();
      toggleBreathBtn.innerHTML = '<i class="fa-solid fa-stop"></i><span>Stop Breathing</span>';

      breathInterval = setInterval(() => {
        breathSecLeft -= 1;
        if (breathSecLeft <= 0) {
          breathPhaseIdx = (breathPhaseIdx + 1) % breathPhases.length;
          breathSecLeft = 4;
        }
        updateBreathVisual();
      }, 1000);
    }

    function renderGrounding() {
      const doneList = Array.isArray(state.groundedSteps) ? state.groundedSteps : [];
      groundButtons.forEach((btn) => {
        const step = Number(btn.getAttribute('data-step'));
        const isDone = doneList.includes(step);
        btn.classList.toggle('done', isDone);
        const icon = btn.querySelector('i');
        if (icon) {
          icon.className = isDone ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle';
        }
      });
      if (groundingStatusText) {
        groundingStatusText.textContent = doneList.length === 5
          ? 'All 5 grounding steps completed — grounded and ready.'
          : `${doneList.length} of 5 grounding steps completed.`;
      }
    }

    function renderGoalProgress() {
      const mins = Math.max(0, Number(state.totalFocusMinutes) || 0);
      const pct = Math.min(100, Math.round((mins / DAILY_GOAL_MIN) * 100));
      if (dailyGoalLabel) {
        dailyGoalLabel.textContent = `${mins} / ${DAILY_GOAL_MIN} min (${pct}%)`;
      }
      if (dailyGoalFill) {
        dailyGoalFill.style.width = `${pct}%`;
      }
    }

    function renderHistory() {
      if (!sessionHistoryList) return;
      if (!state.history || state.history.length === 0) {
        sessionHistoryList.innerHTML = '<div class="history-item"><span class="history-meta">No completed sessions recorded yet.</span></div>';
        return;
      }
      sessionHistoryList.innerHTML = state.history.map((item) => `
        <div class="history-item">
          <div>
            <strong>${escapeHtml(item.title)}</strong>
            <div class="history-meta">${escapeHtml(item.mood)} • ${escapeHtml(item.time)}</div>
          </div>
          <span><strong>${item.minutes} min</strong></span>
        </div>
      `).join('');
    }

    function escapeHtml(str) {
      return String(str || '').replace(/[&<>"']/g, (m) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[m]));
    }

    function renderUI() {
      zenMasterToggle.checked = Boolean(state.enabled);
      zenLiveBadge.classList.toggle('active', Boolean(state.enabled));
      muteAlertsToggle.checked = Boolean(state.muteAlerts);
      pauseMediaToggle.checked = Boolean(state.pauseMedia);
      gentleChimeToggle.checked = Boolean(state.gentleChime);
      quietStartInput.value = state.quietStart || '22:00';
      quietEndInput.value = state.quietEnd || '06:00';
      zenIntentionInput.value = state.intention || '';
      mindfulNoteInput.value = state.mindfulNote || '';
      timerDisplay.textContent = formatTime(state.remainingSeconds);

      presetButtons.forEach((btn) => {
        const m = Number(btn.getAttribute('data-minutes'));
        btn.classList.toggle('active', m === Number(state.presetMinutes));
      });

      soundChips.forEach((chip) => {
        const s = chip.getAttribute('data-sound');
        chip.classList.toggle('active', s === state.sound);
      });

      moodChips.forEach((chip) => {
        const md = chip.getAttribute('data-mood');
        chip.classList.toggle('active', md === state.mood);
      });

      completedSessionsCount.textContent = String(state.completedSessions);
      totalFocusMinutes.textContent = `${state.totalFocusMinutes} min`;
      renderGoalProgress();
      renderGrounding();
      updateQuietWindowStatus();
      renderHistory();
      renderTimerControls();
    }

    async function syncToSupabase() {
      syncStatusText.textContent = 'Syncing Zen state to Supabase...';
      try {
        const payload = {
          zen_enabled: state.enabled,
          preset_minutes: state.presetMinutes,
          intention: state.intention || null,
          mute_alerts: state.muteAlerts,
          pause_media: state.pauseMedia,
          gentle_chime: state.gentleChime,
          quiet_start: state.quietStart,
          quiet_end: state.quietEnd,
          ambient_sound: state.sound,
          mood: state.mood,
          mindful_note: state.mindfulNote || null,
          grounded_steps_count: (state.groundedSteps || []).length,
          completed_sessions: state.completedSessions,
          total_focus_minutes: state.totalFocusMinutes,
          updated_at: new Date().toISOString()
        };

        const response = await fetch(`${SUPABASE_URL}/rest/v1/zen_mode_settings`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          syncStatusText.textContent = 'Synced with Supabase successfully.';
        } else {
          syncStatusText.textContent = 'Saved locally (Supabase table zen_mode_settings not yet created or restricted).';
        }
      } catch (_) {
        syncStatusText.textContent = 'Saved locally (offline or network unavailable).';
      }
    }

    // Event Listeners
    zenMasterToggle.addEventListener('change', () => {
      state.enabled = zenMasterToggle.checked;
      if (!state.enabled && isRunning) {
        pauseTimer();
      }
      saveState();
      renderUI();
      timerStatusText.textContent = state.enabled
        ? 'Zen Mode is enabled.'
        : 'Zen Mode is off.';
    });

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mins = Number(btn.getAttribute('data-minutes')) || 15;
        pauseTimer();
        state.presetMinutes = mins;
        state.remainingSeconds = mins * 60;
        saveState();
        renderUI();
        timerStatusText.textContent = `Timer set to ${mins} minutes.`;
      });
    });

    zenIntentionInput.addEventListener('input', () => {
      state.intention = zenIntentionInput.value;
      saveState();
    });

    startPauseTimerBtn.addEventListener('click', () => {
      if (isRunning) {
        pauseTimer();
        saveState();
        timerStatusText.textContent = 'Session paused.';
      } else {
        startTimer();
      }
    });

    completeSessionBtn.addEventListener('click', () => {
      const elapsedSec = Math.max(60, state.presetMinutes * 60 - state.remainingSeconds);
      const minsDone = Math.max(1, Math.round(elapsedSec / 60));
      state.remainingSeconds = state.presetMinutes * 60;
      pauseTimer();
      recordCompletedSession(minsDone);
    });

    resetTimerBtn.addEventListener('click', () => {
      pauseTimer();
      state.remainingSeconds = state.presetMinutes * 60;
      saveState();
      renderUI();
      timerStatusText.textContent = 'Timer reset.';
    });

    toggleBreathBtn.addEventListener('click', () => {
      if (breathRunning) {
        stopBreathing();
      } else {
        startBreathing();
      }
    });

    groundButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = Number(btn.getAttribute('data-step'));
        const cur = Array.isArray(state.groundedSteps) ? [...state.groundedSteps] : [];
        const idx = cur.indexOf(step);
        if (idx >= 0) {
          cur.splice(idx, 1);
        } else {
          cur.push(step);
        }
        state.groundedSteps = cur;
        saveState();
        renderGrounding();
      });
    });

    clearGroundingBtn.addEventListener('click', () => {
      state.groundedSteps = [];
      saveState();
      renderGrounding();
    });

    muteAlertsToggle.addEventListener('change', () => {
      state.muteAlerts = muteAlertsToggle.checked;
      saveState();
    });

    pauseMediaToggle.addEventListener('change', () => {
      state.pauseMedia = pauseMediaToggle.checked;
      saveState();
    });

    gentleChimeToggle.addEventListener('change', () => {
      state.gentleChime = gentleChimeToggle.checked;
      saveState();
    });

    quietStartInput.addEventListener('change', () => {
      state.quietStart = quietStartInput.value || '22:00';
      saveState();
      updateQuietWindowStatus();
    });

    quietEndInput.addEventListener('change', () => {
      state.quietEnd = quietEndInput.value || '06:00';
      saveState();
      updateQuietWindowStatus();
    });

    soundChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const chosen = chip.getAttribute('data-sound') || 'off';
        state.sound = chosen;
        saveState();
        renderUI();
        if (isRunning && chosen !== 'off') {
          startAmbientSound(chosen);
        } else {
          stopAmbientSound();
        }
      });
    });

    moodChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        state.mood = chip.getAttribute('data-mood') || 'Calm';
        saveState();
        renderUI();
        noteSavedText.textContent = `Mood set to ${state.mood}.`;
      });
    });

    mindfulNoteInput.addEventListener('input', () => {
      state.mindfulNote = mindfulNoteInput.value;
      saveState();
      noteSavedText.textContent = 'Mindful note saved automatically.';
    });

    syncSupabaseBtn.addEventListener('click', syncToSupabase);

    resetZenBtn.addEventListener('click', () => {
      pauseTimer();
      stopBreathing();
      state = { ...defaultState };
      saveState();
      renderUI();
      timerStatusText.textContent = 'Zen settings reset to defaults.';
      syncStatusText.textContent = 'Reset locally.';
    });

    renderUI();
  })();
</script>
</body>
</html>

  <script>
    (function () {
      const CLOUD_URL = "https://gemyqaniztqrsilayblx.supabase.co";
      const CLOUD_KEY = "sb_publishable_FuH8FWiYVK5CnylcjLDIKQ_exLB_Du_";
      const ROW_ID = "default_dashboard";
      const STORAGE_KEY = "autro_settings_time_v1";

      const LOGO_CANDIDATES = [
        "logo.png",
        "./logo.png",
        "/logo.png",
        "assets/logo.png",
        "images/logo.png"
      ];

      function defaultPrefs() {
        return {
          clockFormat: "auto", // "auto" | "12h" | "24h"
          timezone: "local", // "local" or IANA timezone string
          showSeconds: true,
          autoSync: true,
          lastServerIso: ""
        };
      }

      function readLocal() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return defaultPrefs();
          return Object.assign(defaultPrefs(), JSON.parse(raw));
        } catch (e) {
          return defaultPrefs();
        }
      }

      function writeLocal(next) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
        } catch (e) {}
      }

      let prefs = readLocal();
      let syncInterval = null;

      function getEffectiveTimeZone() {
        if (prefs.timezone && prefs.timezone !== "local") {
          return prefs.timezone;
        }
        try {
          return Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
        } catch (e) {
          return "UTC";
        }
      }

      function getHour12Setting() {
        if (prefs.clockFormat === "12h") return true;
        if (prefs.clockFormat === "24h") return false;
        try {
          const resolved = Intl.DateTimeFormat(navigator.language || undefined, {
            hour: "numeric"
          }).resolvedOptions();
          return typeof resolved.hour12 === "boolean" ? resolved.hour12 : true;
        } catch (e) {
          return true;
        }
      }

      function formatClock(dateObj) {
        const d = dateObj instanceof Date ? dateObj : new Date(dateObj);
        if (Number.isNaN(d.getTime())) return "--:--:--";
        const tz = getEffectiveTimeZone();
        const hour12 = getHour12Setting();
        const opts = {
          hour: "2-digit",
          minute: "2-digit",
          hour12,
          timeZone: tz
        };
        if (prefs.showSeconds) {
          opts.second = "2-digit";
        }
        try {
          return d.toLocaleTimeString(navigator.language || undefined, opts);
        } catch (e) {
          return d.toLocaleTimeString([], opts);
        }
      }

      function formatDate(dateObj) {
        const d = dateObj instanceof Date ? dateObj : new Date(dateObj);
        if (Number.isNaN(d.getTime())) return "--";
        const tz = getEffectiveTimeZone();
        try {
          return d.toLocaleDateString(navigator.language || undefined, {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: tz
          });
        } catch (e) {
          return d.toLocaleDateString();
        }
      }

      function renderClock() {
        const now = new Date();
        const tz = getEffectiveTimeZone();
        const hour12 = getHour12Setting();

        const readoutEl = document.getElementById("liveClockReadout");
        const dateEl = document.getElementById("liveDateReadout");
        const zoneLabelEl = document.getElementById("clockZoneLabel");
        const tzBadgeEl = document.getElementById("tzBadge");
        const pillEl = document.getElementById("timeFormatPill");

        if (readoutEl) readoutEl.textContent = formatClock(now);
        if (dateEl) dateEl.textContent = formatDate(now);
        if (zoneLabelEl) {
          zoneLabelEl.textContent =
            prefs.timezone === "local" ? `Local Timezone (${tz})` : `Timezone (${tz})`;
        }
        if (tzBadgeEl) tzBadgeEl.textContent = tz;
        if (pillEl) pillEl.textContent = hour12 ? "12H" : "24H";
      }

      function renderControls() {
        const fmtSel = document.getElementById("clockFormatSelect");
        const tzSel = document.getElementById("timezoneSelect");
        const secToggle = document.getElementById("showSecondsToggle");
        const syncToggle = document.getElementById("autoSyncToggle");
        const syncChip = document.getElementById("lastSyncChip");

        if (fmtSel) fmtSel.value = prefs.clockFormat;
        if (tzSel) {
          const hasOpt = Array.from(tzSel.options).some((o) => o.value === prefs.timezone);
          tzSel.value = hasOpt ? prefs.timezone : "local";
        }
        if (secToggle) secToggle.checked = Boolean(prefs.showSeconds);
        if (syncToggle) syncToggle.checked = prefs.autoSync !== false;

        if (syncChip) {
          syncChip.textContent = prefs.lastServerIso
            ? "Last Sync: " + formatClock(prefs.lastServerIso)
            : "Last Sync: --:--:--";
        }
        renderClock();
      }

      function collectControls() {
        prefs = Object.assign({}, prefs, {
          clockFormat: document.getElementById("clockFormatSelect")?.value || "auto",
          timezone: document.getElementById("timezoneSelect")?.value || "local",
          showSeconds: Boolean(document.getElementById("showSecondsToggle")?.checked),
          autoSync: Boolean(document.getElementById("autoSyncToggle")?.checked)
        });
      }

      async function syncWithSupabase(pushUpdate) {
        const statusChip = document.getElementById("syncStatusChip");
        const syncChip = document.getElementById("lastSyncChip");

        try {
          if (pushUpdate) {
            const nowIso = new Date().toISOString();
            prefs.lastServerIso = nowIso;
            writeLocal(prefs);

            const payload = [
              {
                id: ROW_ID,
                quick_note: `Clock: ${prefs.clockFormat} | TZ: ${getEffectiveTimeZone()}`,
                updated_at: nowIso
              }
            ];

            const res = await fetch(`${CLOUD_URL}/rest/v1/dashboard_state?on_conflict=id`, {
              method: "POST",
              headers: {
                apikey: CLOUD_KEY,
                Authorization: "Bearer " + CLOUD_KEY,
                "Content-Type": "application/json",
                Prefer: "resolution=merge-duplicates,return=minimal"
              },
              body: JSON.stringify(payload)
            });

            if (res.ok) {
              if (statusChip) statusChip.textContent = "Synced";
              if (syncChip) syncChip.textContent = "Last Sync: " + formatClock(nowIso);
              return true;
            }
            if (statusChip) statusChip.textContent = "Local Only";
            return false;
          } else {
            const url = `${CLOUD_URL}/rest/v1/dashboard_state?id=eq.${encodeURIComponent(
              ROW_ID
            )}&select=updated_at`;
            const res = await fetch(url, {
              method: "GET",
              headers: {
                apikey: CLOUD_KEY,
                Authorization: "Bearer " + CLOUD_KEY
              }
            });
            if (!res.ok) return false;
            const rows = await res.json();
            if (Array.isArray(rows) && rows.length > 0 && rows[0].updated_at) {
              prefs.lastServerIso = rows[0].updated_at;
              writeLocal(prefs);
              if (statusChip) statusChip.textContent = "Synced";
              if (syncChip) {
                syncChip.textContent = "Last Sync: " + formatClock(rows[0].updated_at);
              }
              return true;
            }
            return false;
          }
        } catch (err) {
          if (statusChip) statusChip.textContent = "Local Only";
          return false;
        }
      }

      function configureAutoSync() {
        clearInterval(syncInterval);
        if (prefs.autoSync !== false) {
          syncInterval = setInterval(() => {
            syncWithSupabase(false);
          }, 20000);
        }
      }

      function syncSystemTheme() {
        const prefersDark =
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const mode = prefersDark ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", mode);
        document.body.classList.toggle("dark", prefersDark);
        document.body.classList.toggle("theme-dark", prefersDark);

        const chip = document.getElementById("systemThemeChip");
        if (chip) chip.textContent = prefersDark ? "System Dark" : "System Light";
      }

      function loadFooterLogo() {
        const img = document.getElementById("footerLogoImg");
        const fb = document.getElementById("footerLogoFallback");
        if (!img || !fb) return;

        let idx = 0;
        const probe = new Image();

        function tryNext() {
          if (idx >= LOGO_CANDIDATES.length) {
            img.style.display = "none";
            fb.style.display = "inline-flex";
            return;
          }
          const src = LOGO_CANDIDATES[idx++];
          probe.onload = () => {
            img.src = src;
            img.style.display = "block";
            fb.style.display = "none";
          };
          probe.onerror = tryNext;
          probe.src = src;
        }
        tryNext();
      }

      function showToast(msg) {
        const toast = document.getElementById("toast");
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add("show");
        clearTimeout(window._stToastTimer);
        window._stToastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
      }

      document.getElementById("clockFormatSelect")?.addEventListener("change", () => {
        collectControls();
        writeLocal(prefs);
        renderClock();
        showToast("Clock format updated");
      });

      document.getElementById("timezoneSelect")?.addEventListener("change", () => {
        collectControls();
        writeLocal(prefs);
        renderClock();
        showToast(`Timezone: ${getEffectiveTimeZone()}`);
      });

      document.getElementById("showSecondsToggle")?.addEventListener("change", () => {
        collectControls();
        writeLocal(prefs);
        renderClock();
        showToast(prefs.showSeconds ? "Seconds shown" : "Seconds hidden");
      });

      document.getElementById("autoSyncToggle")?.addEventListener("change", () => {
        collectControls();
        writeLocal(prefs);
        configureAutoSync();
        showToast(prefs.autoSync ? "Auto-sync ON" : "Auto-sync OFF");
      });

      document.getElementById("resetTimeBtn")?.addEventListener("click", () => {
        prefs = defaultPrefs();
        writeLocal(prefs);
        renderControls();
        configureAutoSync();
        showToast("Reset time settings");
      });

      document.getElementById("saveTimeBtn")?.addEventListener("click", async () => {
        collectControls();
        writeLocal(prefs);
        renderControls();
        configureAutoSync();
        const ok = await syncWithSupabase(true);
        showToast(ok ? "Time settings saved & synced" : "Saved locally");
      });

      document.getElementById("syncTimeBtn")?.addEventListener("click", async () => {
        const ok = await syncWithSupabase(false);
        showToast(ok ? "Synced with Supabase" : "Using local clock");
      });

      window.addEventListener("storage", (e) => {
        if (e.key === STORAGE_KEY) {
          prefs = readLocal();
          renderControls();
          configureAutoSync();
        }
      });

      if (window.matchMedia) {
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncSystemTheme);
      }

      syncSystemTheme();
      loadFooterLogo();
      renderControls();
      configureAutoSync();
      syncWithSupabase(false);
      setInterval(renderClock, 1000);
    })();
  </script>
</body>
</html>

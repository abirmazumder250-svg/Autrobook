<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Settings - Time &amp; Clock - Autrobook</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Light Theme (Default) */
    :root {
      --bg-page: #ffffff;
      --bg-card: #ffffff;
      --bg-box: #f5f6f7;
      --bg-hover: #eaecef;
      --text-main: #000000;
      --text-muted: #262626;
      --text-invert: #ffffff;
      --border-color: #d4d4d4;
      --accent-bg: #000000;
      --accent-fg: #ffffff;
      --shadow-card: 0 2px 14px rgba(0, 0, 0, 0.05);
    }

    /* Dark Theme */
    html[data-theme="dark"],
    body.dark,
    body.theme-dark {
      --bg-page: #000000;
      --bg-card: #0c0c0c;
      --bg-box: #161616;
      --bg-hover: #222222;
      --text-main: #ffffff;
      --text-muted: #e5e5e5;
      --text-invert: #000000;
      --border-color: #2e2e2e;
      --accent-bg: #ffffff;
      --accent-fg: #000000;
      --shadow-card: 0 6px 24px rgba(0, 0, 0, 0.65);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      padding-bottom: 52px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Sticky Topbar */
    .st-topbar {
      position: sticky;
      top: 0;
      z-index: 60;
      background-color: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 13px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
      flex: 1;
    }

    .back-btn,
    .top-action-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      cursor: pointer;
      flex-shrink: 0;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .back-btn:hover,
    .top-action-btn:hover {
      background-color: var(--bg-hover);
      transform: translateY(-1px);
    }

    .topbar-title {
      font-size: clamp(17px, 4.2vw, 20px);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .st-pill {
      font-size: 11.5px;
      font-weight: 800;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      white-space: nowrap;
    }

    .st-pill.active {
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      border-color: var(--accent-bg);
    }

    /* Main Container */
    .st-container {
      max-width: 820px;
      margin: 0 auto;
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* Cards */
    .st-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 20px;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      gap: 16px;
      scroll-margin-top: 76px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .card-title-group {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .card-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }

    .st-heading {
      font-size: 17px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text-main);
    }

    .badge-tag {
      font-size: 11px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 999px;
      background-color: var(--bg-box);
      color: var(--text-main);
      border: 1px solid var(--border-color);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .st-text {
      font-size: 13.5px;
      line-height: 1.65;
      color: var(--text-muted);
    }

    .meta-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .meta-chip {
      font-size: 11.5px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 999px;
      background-color: var(--bg-box);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    /* Clock Display Box */
    .clock-showcase {
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .clock-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
    }

    .clock-readout {
      font-size: clamp(26px, 6vw, 36px);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
      line-height: 1.2;
    }

    .clock-sub {
      font-size: 12.5px;
      color: var(--text-muted);
    }

    /* Form Controls */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    @media (min-width: 600px) {
      .form-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .field-label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
    }

    .st-select {
      width: 100%;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-box);
      color: var(--text-main);
      font-size: 13px;
      outline: none;
      cursor: pointer;
    }

    .st-select:focus {
      border-color: var(--text-main);
    }

    /* Toggles */
    .options-list {
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    .toggle-row {
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .option-copy strong {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text-main);
    }

    .option-copy span {
      display: block;
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
      line-height: 1.45;
    }

    .switch-control {
      position: relative;
      display: inline-block;
      width: 50px;
      height: 28px;
      flex-shrink: 0;
      cursor: pointer;
    }

    .switch-control input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .switch-slider {
      position: absolute;
      inset: 0;
      background-color: #737373;
      border-radius: 999px;
      transition: background-color 0.2s ease;
    }

    .switch-slider::before {
      content: "";
      position: absolute;
      width: 22px;
      height: 22px;
      left: 3px;
      top: 3px;
      background-color: #ffffff;
      border-radius: 50%;
      transition: transform 0.2s ease;
    }

    .switch-control input:checked + .switch-slider {
      background-color: var(--accent-bg);
    }

    .switch-control input:checked + .switch-slider::before {
      transform: translateX(22px);
      background-color: var(--accent-fg);
    }

    /* Navigation Grid */
    .nav-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    @media (min-width: 600px) {
      .nav-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .nav-tile {
      background-color: var(--bg-box);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 13px 15px;
      text-decoration: none;
      color: var(--text-main);
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      transition: background-color 0.15s ease, transform 0.12s ease;
    }

    .nav-tile:hover {
      background-color: var(--bg-hover);
      transform: translateY(-1px);
    }

    /* Actions */
    .actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: flex-end;
    }

    .btn-outline,
    .btn-solid {
      padding: 10px 16px;
      border-radius: 11px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border: 1px solid var(--accent-bg);
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 0.15s ease, transform 0.12s ease;
    }

    .btn-outline {
      background-color: var(--bg-box);
      color: var(--text-main);
    }

    .btn-outline:hover {
      background-color: var(--bg-hover);
      transform: translateY(-1px);
    }

    .btn-solid {
      background-color: var(--accent-bg);
      color: var(--accent-fg);
    }

    .btn-solid:hover {
      transform: translateY(-1px);
    }

    /* Footer */
    .st-footer {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 14px 16px;
      box-shadow: var(--shadow-card);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .footer-logo-wrap {
      width: 20px;
      height: 20px;
      min-width: 20px;
      max-width: 20px;
      min-height: 20px;
      max-height: 20px;
      border-radius: 5px;
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    .footer-logo-img {
      width: 20px;
      height: 20px;
      max-width: 20px;
      max-height: 20px;
      object-fit: cover;
      display: none;
    }

    .footer-logo-fallback {
      font-size: 11px;
      font-weight: 800;
      line-height: 1;
    }

    .footer-caption {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* Toast */
    #toast {
      position: fixed;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--accent-bg);
      color: var(--accent-fg);
      border: 1px solid var(--border-color);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 999;
      max-width: 90vw;
      text-align: center;
    }

    #toast.show {
      opacity: 1;
    }
  </style>
</head>
<body>
  <header class="st-topbar">
